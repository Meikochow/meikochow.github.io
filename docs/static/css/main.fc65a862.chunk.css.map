@charset "UTF-8";
.ContactMe {
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  justify-content: center; }
  .ContactMe .message {
    min-height: 300px;
    display: flex;
    flex-direction: column;
    justify-content: center; }
    .ContactMe .message .textLine {
      padding: 10px 0px 10px 0px; }
    .ContactMe .message .textLine1 {
      font-size: 40px;
      font-weight: bold;
      font-family: 'Major Mono Display'; }
    .ContactMe .message .textLine2 {
      font-size: 34px;
      font-family: 'Noto Serif SC'; }
      .ContactMe .message .textLine2 .see {
        animation: wink 10s infinite; }

@keyframes wink {
  39% {
    color: #fff; }
  40% {
    color: #10e3ff; }
  41% {
    color: #3700ff ş; }
  42% {
    color: #241274; }
  43% {
    color: #00e1ff; }
  44% {
    color: #c300ff; }
  45% {
    color: #fff; } }
    .ContactMe .message .textLine3 {
      font-size: 34px;
      font-weight: bold;
      font-family: 'Amatic SC'; }
      .ContactMe .message .textLine3 .terarium {
        width: 20px;
        display: inline-block;
        animation: terarium 10s  infinite; }

@keyframes terarium {
  5% {
    transform: translate(0px, 0px); }
  10% {
    transform: translate(300px, 0px); }
  15% {
    transform: translate(300px, 0px); }
  20% {
    transform: translate(0px, 0px); } }
      .ContactMe .message .textLine3 .bug {
        height: 30px;
        width: 30px;
        margin-left: -14px;
        animation: bug 10s  infinite; }

@keyframes bug {
  4% {
    transform: rotateZ(0deg); }
  5% {
    transform: rotateZ(90deg); }
  9% {
    transform: rotateZ(90deg); }
  10% {
    transform: rotateZ(270deg); }
  14% {
    transform: rotateZ(300deg); }
  15% {
    transform: rotateZ(270deg); }
  19% {
    transform: rotateZ(270deg); }
  20% {
    transform: rotateZ(360deg); }
  23% {
    transform: rotateZ(360deg); }
  24% {
    transform: rotateZ(360deg); }
  25% {
    transform: rotateZ(0deg); }
  26% {
    transform: rotateZ(0deg); } }
    .ContactMe .message .textLine4 {
      font-size: 28px;
      font-weight: bold;
      font-family: 'Oranienbaum'; }
  .ContactMe .mediaContainer .ContactIcon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    margin: 5px; }
  .ContactMe .mediaContainer .ContactIcon:hover {
    animation: hoverIcon 1s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
    box-shadow: 0px 0px 5px black; }

@keyframes hoverIcon {
  0% {
    transform: rotate(0deg); }
  90% {
    transform: rotate(726deg); }
  100% {
    transform: rotate(720deg); } }

@media screen and (max-width: 500px) {
  .ContactMe {
    justify-content: flex-start; }
    .ContactMe .message .textLine1 {
      font-size: 30px; }
    .ContactMe .message .textLine2 {
      font-size: 30px; }
    .ContactMe .message .textLine3 {
      font-size: 25px; }
    .ContactMe .message .textLine4 {
      font-size: 16px; }
    .ContactMe .mediaContainer .ContactIcon {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      margin: 5px; } }
